; Extra steps for the Tauri NSIS installer / uninstaller.
; The uninstaller itself (uninstall.exe, Start Menu entry, Add/Remove Programs) is generated by Tauri.

!macro NSIS_HOOK_POSTINSTALL
  ; Explorer right-click: "Rewind this file" (Windows 11: under "Show more options")
  WriteRegStr HKCU "Software\Classes\*\shell\RewindThisFile" "" "Rewind this file"
  WriteRegStr HKCU "Software\Classes\*\shell\RewindThisFile" "Icon" "$INSTDIR\${MAINBINARYNAME}.exe"
  WriteRegStr HKCU "Software\Classes\*\shell\RewindThisFile\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" --rewind-file "%1"'
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  DeleteRegKey HKCU "Software\Classes\*\shell\RewindThisFile"
  ; Ask before deleting history. Silent uninstalls (/S) and upgrades keep it.
  ${If} $UpdateMode <> 1
    MessageBox MB_YESNO|MB_ICONQUESTION "Also delete all Rewind file history and settings?$\r$\n$\r$\nThis frees disk space, but the saved versions cannot be recovered." /SD IDNO IDNO +2
      RMDir /r "$LOCALAPPDATA\Rewind"
  ${EndIf}
!macroend
