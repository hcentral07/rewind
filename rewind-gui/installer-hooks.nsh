; Extra steps for the Tauri NSIS installer / uninstaller.
; The uninstaller itself (uninstall.exe, Start Menu entry, Add/Remove Programs) is generated by Tauri.

!macro NSIS_HOOK_POSTINSTALL
  ; Explorer right-click: "Rewind: show history" on files, folders and folder backgrounds
  ; (Windows 11: under "Show more options"). Replaces the 0.2 "Rewind this file" entry.
  DeleteRegKey HKCU "Software\Classes\*\shell\RewindThisFile"
  WriteRegStr HKCU "Software\Classes\*\shell\RewindHistory" "" "Rewind: show history"
  WriteRegStr HKCU "Software\Classes\*\shell\RewindHistory" "Icon" "$INSTDIR\${MAINBINARYNAME}.exe"
  WriteRegStr HKCU "Software\Classes\*\shell\RewindHistory\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" --rewind-file "%1"'
  WriteRegStr HKCU "Software\Classes\Directory\shell\RewindHistory" "" "Rewind: show history"
  WriteRegStr HKCU "Software\Classes\Directory\shell\RewindHistory" "Icon" "$INSTDIR\${MAINBINARYNAME}.exe"
  WriteRegStr HKCU "Software\Classes\Directory\shell\RewindHistory\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" --rewind-folder "%1"'
  WriteRegStr HKCU "Software\Classes\Directory\Background\shell\RewindHistory" "" "Rewind: show history"
  WriteRegStr HKCU "Software\Classes\Directory\Background\shell\RewindHistory" "Icon" "$INSTDIR\${MAINBINARYNAME}.exe"
  WriteRegStr HKCU "Software\Classes\Directory\Background\shell\RewindHistory\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" --rewind-folder "%V"'
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  DeleteRegKey HKCU "Software\Classes\*\shell\RewindThisFile"
  DeleteRegKey HKCU "Software\Classes\*\shell\RewindHistory"
  DeleteRegKey HKCU "Software\Classes\Directory\shell\RewindHistory"
  DeleteRegKey HKCU "Software\Classes\Directory\Background\shell\RewindHistory"
  ; Ask before deleting history. Silent uninstalls (/S) and upgrades keep it.
  ${If} $UpdateMode <> 1
    MessageBox MB_YESNO|MB_ICONQUESTION "Also delete all Rewind file history and settings?$\r$\n$\r$\nThis frees disk space, but the saved versions cannot be recovered." /SD IDNO IDNO +2
      RMDir /r "$LOCALAPPDATA\Rewind"
  ${EndIf}
!macroend
